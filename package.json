{
  "name": "solecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:deploy": "node --test scripts/deploy-config.test.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "lighthouse:ci": "node scripts/run-lighthouse.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write src e2e scripts content package.json index.html vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js README.md .github",
    "format:check": "prettier --check src e2e scripts content package.json index.html vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js README.md .github",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=chromium",
    "e2e:deployed": "playwright test e2e/deployed-smoke.m10.spec.ts --project=chromium",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local supabase/tests/database"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "sass": "1.103.1",
    "web-vitals": "6.2.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "lighthouse": "13.4.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
